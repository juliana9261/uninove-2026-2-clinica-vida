@model Medico
@{
    ViewData["Title"] = Model.Nome;
}

<h2>@Model.Nome</h2>

<dl>
    <dt>CRM</dt>
    <dd>@Model.Crm</dd>
    <dt>Especialidade</dt>
    <dd>@(Model.Especialidade?.Nome ?? "Não informada")</dd>
</dl>

<a href="/Medicos?especialidadeId=@Model.EspecialidadeId">Outros médicos desta especialidade</a> |
<a href="/Medicos">Voltar ao corpo clínico</a>
